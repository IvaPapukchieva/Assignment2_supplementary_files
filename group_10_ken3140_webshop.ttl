@prefix : <http://example.org/bookshop#> .
@prefix bookshop: <http://example.org/bookshop#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Basket a rdfs:Class ;
    rdfs:label "Basket" ;
    rdfs:comment "Shopping cart which contains products during shopping." .

:ChildrensBook a rdfs:Class ;
    rdfs:label "Children’sBook" ;
    rdfs:comment "A book in genre recommended for children." ;
    rdfs:subClassOf :Genre .

:Discount a rdfs:Class ;
    rdfs:label "Discount" ;
    rdfs:comment "A reduction of price of the product." .

:Fantasy a rdfs:Class ;
    rdfs:label "Fantasy" ;
    rdfs:comment """Type of general fiction which includes supernatural elements.
""" ;
    rdfs:subClassOf :GeneralFiction .

:Games a rdfs:Class ;
    rdfs:label "Games" ;
    rdfs:comment "Game possible to purchase in the shop." ;
    rdfs:subClassOf schema:Product .

:GeneralFiction a rdfs:Class ;
    rdfs:label "GeneralFiction" ;
    rdfs:comment "A category of genres which includes fiction stories. " ;
    rdfs:subClassOf :Genre .

:Genre a rdfs:Class ;
    rdfs:label "Genre" ;
    rdfs:comment "Classifies books to the type based on what topic are they about." .

:Horror a rdfs:Class ;
    rdfs:label "Horror" ;
    rdfs:comment "Type of general fiction which includes scary stories." ;
    rdfs:subClassOf :GeneralFiction .

:Mathematics a rdfs:Class ;
    rdfs:label "Mathematics" ;
    rdfs:comment "Type of non-fiction which is about the topic of mathematics." ;
    rdfs:subClassOf :Non-fiction .

:Non-fiction a rdfs:Class ;
    rdfs:label "Non-fiction" ;
    rdfs:comment "A category of genres which includes real facts and true events." ;
    rdfs:subClassOf :Genre .

:Philosophy a rdfs:Class ;
    rdfs:label "Philosophy" ;
    rdfs:comment "Type of non-fiction which is about the topic of philosophy." ;
    rdfs:subClassOf :Non-fiction .

:Publisher a rdfs:Class ;
    rdfs:label "Publisher" ;
    rdfs:comment "A publisher who takes care of releasing a product. " .

:Romance a rdfs:Class ;
    rdfs:label "Romance" ;
    rdfs:comment "Type of general fiction which includes romantic stories." ;
    rdfs:subClassOf :GeneralFiction .

:Travel a rdfs:Class ;
    rdfs:label "Travel" ;
    rdfs:comment "Type of non-fiction which is about the topic of traveling." ;
    rdfs:subClassOf :Non-fiction .

schema:Book a rdfs:Class ;
    rdfs:label "Book" ;
    rdfs:comment "Book possible to purchase in the shop." ;
    rdfs:subClassOf schema:Product .

schema:Order a rdfs:Class ;
    rdfs:label "Order" ;
    rdfs:comment "A customer order which contains products." .

schema:Person a rdfs:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A person which might be a customer of the shop or an author of a book." .

schema:Product a rdfs:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A product possible to purchase in the book shop." .

schema:address a rdfs:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address used for delivering products." .

schema:author a rdfs:Class ;
    rdfs:label "Author" ;
    rdfs:comment "An author who wrote a book." ;
    rdfs:subClassOf schema:Person .

schema:customer a rdfs:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A person who purchases products from the shop." ;
    rdfs:subClassOf schema:Person .

:basketContains a rdfs:Property ;
    rdfs:label "basketContains" ;
    rdfs:comment "Relates the basket to the products which customer wants to purchase." ;
    rdfs:domain :Basket ;
    rdfs:range schema:Product .

:belongsToGenre a rdfs:Property ;
    rdfs:label "belongsToGenre" ;
    rdfs:comment "Relates a book to its genre." ;
    rdfs:domain :Book ;
    rdfs:range :Genre .

:bookISBN a rdfs:Property ;
    rdfs:label "bookISBN" ;
    rdfs:comment "The ISBN number of the book (officially defined as a string)." ;
    rdfs:domain :Book ;
    rdfs:range xsd:string .

:bookTitle a rdfs:Property ;
    rdfs:label "bookTitle" ;
    rdfs:comment "The textual title of the book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:string .

:description a rdfs:Property ;
    rdfs:label "description" ;
    rdfs:comment "Textual description on what the book is about." ;
    rdfs:domain :Product ;
    rdfs:range xsd:string .

:hasAddress a rdfs:Property ;
    rdfs:label "hasAddress" ;
    rdfs:comment "Relates the customer to the address for delivery." ;
    rdfs:domain :Customer ;
    rdfs:range schema:address .

:hasDiscount a rdfs:Property ;
    rdfs:label "hasDiscount" ;
    rdfs:comment "Relates the product to the discount that is applicable to it." ;
    rdfs:domain :Product ;
    rdfs:range :Discount .

:isAuthorOf a rdfs:Property ;
    rdfs:label "isAuthorOf" ;
    rdfs:comment "Relates the author to the book that they have written." ;
    rdfs:domain :Author ;
    rdfs:range schema:Book .

:numberOfPages a rdfs:Property ;
    rdfs:label "numberOfPages" ;
    rdfs:comment "Integer number of pages that the book has." ;
    rdfs:domain :Book ;
    rdfs:range xsd:integer .

:orderContains a rdfs:Property ;
    rdfs:label "orderContains" ;
    rdfs:comment "Relates the basket to the products which customer purchased." ;
    rdfs:domain :Order ;
    rdfs:range schema:Product .

:placesOrder a rdfs:Property ;
    rdfs:label "placesOrder" ;
    rdfs:comment "Relates the customer to the order that they have placed." ;
    rdfs:domain :Customer ;
    rdfs:range schema:Order .

:price a rdfs:Property ;
    rdfs:label "price" ;
    rdfs:comment "The monetary price of the book." ;
    rdfs:domain :Product ;
    rdfs:range xsd:decimal .

:publishedBy a rdfs:Property ;
    rdfs:label "publishedBy" ;
    rdfs:comment "Relates the product to the publisher which published it." ;
    rdfs:domain :Product ;
    rdfs:range :Publisher .

:publishedOn a rdfs:Property ;
    rdfs:label "publishedOn" ;
    rdfs:comment "The date on which the product was published." ;
    rdfs:domain :Product ;
    rdfs:range xsd:date .

